// FluxBridge desktop UI.
//
// Minimal but valid Slint markup compiled by build.rs (behind the `gui`
// feature). It defines the main window with a connection status label and a
// video surface placeholder, plus an UpdateDialog component that surfaces the
// in-app updater: release notes, a download progress bar bound to a property,
// and exactly two buttons labelled "Actualizeaza acum" and "Mai tarziu / Refuza".

import { Button, VerticalBox, HorizontalBox, ProgressIndicator, ScrollView } from "std-widgets.slint";

// Non-intrusive update notification dialog. Shown only when an update is
// available. The two action callbacks are wired in src/updater_ui.rs.
component UpdateDialog inherits Rectangle {
    // Release version tag, for example "v1.2.0".
    in property <string> version;
    // Markdown release notes to display to the user.
    in property <string> release-notes;
    // Download progress in 0..=100, bound to the progress bar.
    in property <float> progress;
    // Whether a download is currently in flight (disables the accept button).
    in property <bool> downloading: false;
    // A user-facing status or error line (empty when there is nothing to show).
    // Carries apply results ("downloaded, apply manually") and failure text so
    // the dialog never silently hides a failed or no-op update.
    in property <string> status;
    // Whether the status line should be styled as an error.
    in property <bool> status-is-error: false;

    // User accepted: "Actualizeaza acum" (Update now).
    callback accept();
    // User declined: "Mai tarziu / Refuza" (Later / Decline).
    callback dismiss();

    background: #202124;
    border-radius: 8px;
    border-width: 1px;
    border-color: #3c4043;

    VerticalBox {
        padding: 16px;
        spacing: 10px;

        Text {
            text: "Actualizare disponibila: " + root.version;
            font-size: 16px;
            font-weight: 700;
            color: white;
        }

        ScrollView {
            height: 120px;
            Text {
                text: root.release-notes;
                wrap: word-wrap;
                color: #e8eaed;
            }
        }

        ProgressIndicator {
            progress: root.progress / 100;
        }

        // Status / error line. Shown only when there is something to report so
        // apply results and failures are visible instead of silently hiding.
        if root.status != "": Text {
            text: root.status;
            wrap: word-wrap;
            color: root.status-is-error ? #f28b82 : #81c995;
        }

        HorizontalBox {
            spacing: 8px;
            Button {
                text: "Actualizeaza acum";
                primary: true;
                enabled: !root.downloading;
                clicked => {
                    root.accept();
                }
            }
            Button {
                text: "Mai tarziu / Refuza";
                enabled: !root.downloading;
                clicked => {
                    root.dismiss();
                }
            }
        }
    }
}

// In-app help / "how to connect" panel. Shown only when the user opens it from
// the Help button in the MainWindow. Mirrors the UpdateDialog structure: a
// title, a ScrollView wrapping the body text, and a single action button. The
// body text is supplied from src/ui.rs (HELP_TEXT) so the copy lives next to
// the Rust wiring and stays easy to keep accurate.
component HelpDialog inherits Rectangle {
    // The full help body (prerequisites + connection steps). Set from Rust.
    in property <string> body;

    // User closed the panel.
    callback close();

    background: #202124;
    border-radius: 8px;
    border-width: 1px;
    border-color: #3c4043;

    VerticalBox {
        padding: 16px;
        spacing: 10px;

        Text {
            text: "Help: how to connect a phone";
            font-size: 16px;
            font-weight: 700;
            color: white;
        }

        // Scrollable guide. The ScrollView gets a bounded height via
        // vertical-stretch (it fills the leftover panel space). The inner Text
        // is wrapped in a VerticalLayout whose min-height reflects the full
        // wrapped body, so the scrollable content is taller than the viewport
        // and Slint produces a working vertical scrollbar instead of clipping.
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start;
                body-text := Text {
                    text: root.body;
                    wrap: word-wrap;
                    color: #e8eaed;
                    // Report the full wrapped height so the enclosing layout is
                    // at least this tall; this is what gives the ScrollView
                    // content that exceeds its bounded viewport.
                    min-height: self.preferred-height;
                }
            }
        }

        HorizontalBox {
            alignment: end;
            Button {
                text: "Close";
                primary: true;
                clicked => {
                    root.close();
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "FluxBridge";
    preferred-width: 960px;
    preferred-height: 600px;
    background: #17181a;

    // Connection status text, for example "Connected to 127.0.0.1:27183".
    in property <string> connection-status: "Disconnected";
    // Live pipeline status/error from the adb-driven startup (routed from the
    // background thread through a channel, NOT a console). Shown on the video
    // surface so failures like "adb not found" or "no device" are visible in a
    // windowed build that has no stdout.
    in property <string> pipeline-status: "Idle";
    // Whether the latest pipeline status is an error (styled red).
    in property <bool> pipeline-status-is-error: false;
    // Whether the update dialog is visible.
    in property <bool> update-available: false;
    // Properties forwarded to the UpdateDialog.
    in property <string> update-version;
    in property <string> update-notes;
    in property <float> update-progress;
    in property <bool> update-downloading: false;
    in property <string> update-status;
    in property <bool> update-status-is-error: false;
    // Whether the help panel is visible, and the help body text (from ui.rs).
    in property <bool> help-visible: false;
    in property <string> help-text;
    // Whether the landing / start menu is visible. Shown on launch; hidden once
    // the user clicks Start to begin mirroring.
    in property <bool> menu-visible: true;
    // The decoded video frame to display. Empty until the first frame arrives,
    // in which case the fallback placeholder + pipeline status are shown.
    in property <image> frame;
    // A general status line (for example the manual "Check for updates" result:
    // "You are on the latest version"). Shown transiently near the top bar.
    in property <string> app-status;
    // Whether the general status line should be styled as an error.
    in property <bool> app-status-is-error: false;

    // Re-exported dialog callbacks so main.rs / updater_ui.rs can connect them.
    callback update-accept();
    callback update-dismiss();
    // Help panel callbacks: open/toggle from the Help button, close from the panel.
    callback help-toggle();
    callback help-close();
    // Start-menu callbacks, wired in src/ui.rs.
    callback start();
    callback quit();
    callback check-for-updates();
    // A pointer tap on the video surface, reported as normalized coordinates
    // (0.0..=1.0) plus a pressed flag. ui.rs scales to device pixels and sends
    // it through the scrcpy control sink. This is the input-injection path.
    callback video-pointer(float, float, bool);

    VerticalBox {
        padding: 12px;
        spacing: 8px;

        // Top bar: connection status on the left, a general status line in the
        // middle, a Help button on the right.
        HorizontalBox {
            alignment: space-between;
            Text {
                text: root.connection-status;
                color: #9aa0a6;
                font-size: 13px;
                vertical-alignment: center;
            }
            if root.app-status != "": Text {
                text: root.app-status;
                color: root.app-status-is-error ? #f28b82 : #81c995;
                font-size: 13px;
                vertical-alignment: center;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            Button {
                text: "Help";
                clicked => {
                    root.help-toggle();
                }
            }
        }

        // Video surface. When a decoded frame has arrived it is drawn as an
        // Image; otherwise a fallback placeholder plus the live pipeline status
        // are shown so the user always sees connection progress or errors.
        video := Rectangle {
            background: black;
            border-radius: 4px;
            vertical-stretch: 1;

            // The decoded frame, scaled to fit. When `frame` is empty the Image
            // draws nothing and the fallback below shows through.
            Image {
                source: root.frame;
                image-fit: contain;
                width: 100%;
                height: 100%;
            }

            // Pointer input over the video surface. Taps/moves are reported to
            // Rust as NORMALIZED coordinates (0.0..=1.0 across the surface) plus
            // a pressed flag; ui.rs scales them to the device resolution and
            // forwards them through the scrcpy control sink. Only active once
            // mirroring has started (the menu is hidden).
            if !root.menu-visible: TouchArea {
                width: 100%;
                height: 100%;
                clicked => {
                    root.video-pointer(
                        self.mouse-x / video.width,
                        self.mouse-y / video.height,
                        true,
                    );
                }
            }

            // Fallback placeholder + live pipeline status. Hidden once a real
            // frame is present (width > 0 means a frame was set).
            if root.frame.width == 0: VerticalBox {
                alignment: center;
                Text {
                    text: "No video yet";
                    color: #5f6368;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                // Live pipeline status/error, fed from the adb pipeline channel.
                Text {
                    text: root.pipeline-status;
                    color: root.pipeline-status-is-error ? #f28b82 : #81c995;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
    }

    // Landing / start menu, centered over the window on launch. Hidden once the
    // user clicks Start. Buttons: Start, Check for updates, Help, Quit.
    if root.menu-visible: Rectangle {
        // Dim the backdrop so the menu reads as a modal landing panel.
        background: #000000cc;

        Rectangle {
            width: min(360px, parent.width - 48px);
            height: min(360px, parent.height - 48px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #202124;
            border-radius: 8px;
            border-width: 1px;
            border-color: #3c4043;

            VerticalBox {
                padding: 20px;
                spacing: 12px;
                alignment: center;

                Text {
                    text: "FluxBridge";
                    font-size: 22px;
                    font-weight: 700;
                    color: white;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Mirror and control your phone from this PC.";
                    color: #9aa0a6;
                    font-size: 13px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                Button {
                    text: "Start";
                    primary: true;
                    clicked => {
                        root.start();
                    }
                }
                Button {
                    text: "Check for updates";
                    clicked => {
                        root.check-for-updates();
                    }
                }
                Button {
                    text: "Help";
                    clicked => {
                        root.help-toggle();
                    }
                }
                Button {
                    text: "Quit";
                    clicked => {
                        root.quit();
                    }
                }
            }
        }
    }

    // Help panel, centered over the window when opened from the Help button.
    if root.help-visible: HelpDialog {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(640px, parent.width - 32px);
        height: min(480px, parent.height - 32px);
        body: root.help-text;
        close => {
            root.help-close();
        }
    }

    if root.update-available: UpdateDialog {
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 16px;
        width: 360px;
        version: root.update-version;
        release-notes: root.update-notes;
        progress: root.update-progress;
        downloading: root.update-downloading;
        status: root.update-status;
        status-is-error: root.update-status-is-error;
        accept => {
            root.update-accept();
        }
        dismiss => {
            root.update-dismiss();
        }
    }
}
